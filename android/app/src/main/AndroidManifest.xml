<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive a 3D scan (.glb) shared or opened from a scanning app such as Scaniverse. -->
            <intent-filter android:label="Use in Nidorama">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="Use in Nidorama">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="model/gltf-binary" />
            </intent-filter>

        </activity>

        <!-- Home-screen (launcher) mode for the wall tablet. Off by default; switched on from
             Nidorama's Settings, then chosen with Android's "default home app" picker.
             Not a kiosk: the notification shade and system settings stay reachable. -->
        <activity-alias
            android:name=".HomeLauncher"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Lets Nidorama find and open the Home Assistant companion app (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.homeassistant.companion.android" />
        <package android:name="io.homeassistant.companion.android.minimal" />
        <package android:name="com.nianticlabs.scaniverse" />
        <package android:name="app.homey" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kiosk mode: a swipe can pull down the notification tray. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- In-app updates: lets Nidorama hand a downloaded APK to Android's installer (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Update available" notifications (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
