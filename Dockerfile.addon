# Builds the Nidorama Home Assistant add-on image (context: repository root).
FROM node:22-alpine AS web
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY index.html vite.config.js ./
COPY public public
COPY src src
ARG NIDORAMA_VERSION
RUN NIDORAMA_VERSION=$NIDORAMA_VERSION npx vite build

FROM node:22-alpine
WORKDIR /app
# The render engine: a headless browser that draws in software (no graphics card needed).
RUN apk add --no-cache chromium && (apk add --no-cache chromium-swiftshader || true)
COPY addon/nidorama/package.json addon/nidorama/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY addon/nidorama/server.mjs ./
COPY addon/nidorama/test ./test
COPY --from=web /src/dist ./www
ENV PORT=8099
EXPOSE 8099
CMD ["node", "server.mjs"]
